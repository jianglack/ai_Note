# Environment variable reference for API keys.
# Set these as environment variables before starting the application.
# The app will fail-fast on startup if required keys are missing.
#
# Required:
#   DEEPSEEK_API_KEY  - DeepSeek chat and embedding provider
#
# Optional:
#   DEEPSEEK_MODEL                - Defaults to deepseek-chat
#   DEEPSEEK_BASE_URL             - Defaults to https://api.deepseek.com/v1
#   DEEPSEEK_EMBEDDING_MODEL      - Defaults to DEEPSEEK_MODEL
#   DEEPSEEK_EMBEDDING_BASE_URL   - Defaults to DEEPSEEK_BASE_URL
#   COHERE_API_KEY                - Cohere reranking, disabled if absent
#   MEMORY_CAPTURE_ADVISOR_ENABLED        - Defaults to false
#   MEMORY_CAPTURE_ADVISOR_MIN_CONFIDENCE - Defaults to 0.82
#   MEMORY_ADVISOR_FORMAL_EVAL_ENABLED              - Defaults to false; set true only for live advisor evaluation
#   MEMORY_ADVISOR_FORMAL_EVAL_MAX_CASES            - Defaults to 4000
#   MEMORY_ADVISOR_FORMAL_EVAL_MIN_CASES            - Defaults to 4000
#   MEMORY_ADVISOR_FORMAL_EVAL_MAX_COST_YUAN        - Defaults to 20.0
#   MEMORY_ADVISOR_FORMAL_EVAL_MAX_INPUT_TOKENS     - Defaults to 2000000
#   MEMORY_ADVISOR_FORMAL_EVAL_OUTPUT_TOKENS_PER_CASE - Defaults to 256
#   MEMORY_ADVISOR_FORMAL_EVAL_REPORT_DIR           - Defaults to target/memory-advisor-formal-eval
#   MEMORY_ADVISOR_FORMAL_EVAL_BATCH_SIZE           - Defaults to 25
#   MEMORY_ADVISOR_FORMAL_EVAL_PER_CASE_TIMEOUT_MILLIS - Defaults to 180000
#   MEMORY_ADVISOR_FORMAL_EVAL_RESUME               - Defaults to true
#   MEMORY_ADVISOR_FORMAL_EVAL_PROGRESS_PATH        - Defaults to <report-dir>/<run-id>.progress.jsonl
#   MEMORY_ADVISOR_FORMAL_EVAL_BATCH_REPORT_PATH    - Defaults to <report-dir>/<run-id>.batch.json
#   MEMORY_ADVISOR_FORMAL_EVAL_MODEL_MAX_TOKENS     - Defaults to 256
#   MEMORY_ADVISOR_FORMAL_EVAL_MODEL_TIMEOUT_SECONDS - Defaults to 60
#   MEMORY_ADVISOR_FORMAL_EVAL_RETRY_UNAVAILABLE_PROGRESS - Defaults to false; set true to rerun unavailable progress rows
#   MEMORY_ADVISOR_FORMAL_EVAL_MAX_ATTEMPTS         - Defaults to 3
#   MEMORY_ADVISOR_FORMAL_EVAL_RETRY_INITIAL_BACKOFF_MILLIS - Defaults to 1000
#   MEMORY_ADVISOR_FORMAL_EVAL_RETRY_MAX_BACKOFF_MILLIS - Defaults to 15000
#   MEMORY_ADVISOR_RELEASE_GATE_MAX_REPORT_AGE_HOURS - Defaults to 168

app:
  deepseek:
    api-key: ${DEEPSEEK_API_KEY:}
    model: ${DEEPSEEK_MODEL:deepseek-chat}
    base-url: ${DEEPSEEK_BASE_URL:https://api.deepseek.com/v1}
    embedding-model: ${DEEPSEEK_EMBEDDING_MODEL:${DEEPSEEK_MODEL:deepseek-chat}}
    embedding-base-url: ${DEEPSEEK_EMBEDDING_BASE_URL:${DEEPSEEK_BASE_URL:https://api.deepseek.com/v1}}

  cohere:
    api-key: ${COHERE_API_KEY:}

  memory:
    capture:
      advisor:
        enabled: ${MEMORY_CAPTURE_ADVISOR_ENABLED:false}
        min-confidence: ${MEMORY_CAPTURE_ADVISOR_MIN_CONFIDENCE:0.82}
