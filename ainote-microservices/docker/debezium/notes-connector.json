{
  "name": "ainote-notes-connector",
  "config": {
    "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
    "database.hostname": "postgres",
    "database.port": "5432",
    "database.user": "ainote",
    "database.password": "${file:/run/secrets/db_password}",
    "database.dbname": "ainote_notes",
    "database.server.name": "pg-notes",
    "plugin.name": "pgoutput",
    "table.include.list": "public.notes",
    "topic.prefix": "pg-notes",
    "slot.name": "ainote_notes_slot",
    "publication.name": "ainote_notes_pub",
    "transforms": "unwrap",
    "transforms.unwrap.type": "io.debezium.transforms.ExtractNewRecordState",
    "transforms.unwrap.drop.tombstones": "false",
    "transforms.unwrap.delete.handling.mode": "rewrite"
  }
}
