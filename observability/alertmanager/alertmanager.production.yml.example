global:
  resolve_timeout: 5m

route:
  receiver: warning-provider
  group_by: [service, alertname, severity]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h
  routes:
    - receiver: critical-provider
      matchers: ['severity="critical"']
      group_wait: 10s
      repeat_interval: 30m

receivers:
  - name: critical-provider
    webhook_configs:
      - url_file: /run/secrets/critical_alert_webhook_url
        send_resolved: true
  - name: warning-provider
    webhook_configs:
      - url_file: /run/secrets/warning_alert_webhook_url
        send_resolved: true

inhibit_rules:
  - source_matchers: ['alertname="AiNoteBackendDown"', 'severity="critical"']
    target_matchers: ['service="ainote-backend"', 'alertname!="AiNoteBackendDown"']
    equal: [service]
